{% extends "spin-to-win/_layouts/cp" %}

{% set selectedSubnavItem = 'reports' %}
{% set title = 'Reports & Analytics'|t('spin-to-win') %}

{% set isProEdition = isPro ?? false %}

{% block actionButton %}
    {% if isProEdition %}
        <div style="display: flex; gap: 8px;">
            <a href="{{ cpUrl('spin-to-win/reports/export', { type: 'spins', campaignId: campaignId, site: craft.app.request.getQueryParam('site'), siteId: selectedSiteId }) }}" class="btn download icon">{{ 'Export Spins CSV'|t('spin-to-win') }}</a>
            <a href="{{ cpUrl('spin-to-win/reports/export', { type: 'coupons', campaignId: campaignId, site: craft.app.request.getQueryParam('site'), siteId: selectedSiteId }) }}" class="btn download icon">{{ 'Export Coupons CSV'|t('spin-to-win') }}</a>
        </div>
    {% else %}
        <div style="display: flex; align-items: center; gap: 8px;">
            <span class="badge" style="background: #e2e8f0; color: #64748b; font-size: 12px; padding: 6px 12px; border-radius: 6px;">{{ "CSV Export (Pro Only)"|t('spin-to-win') }}</span>
        </div>
    {% endif %}
{% endblock %}

{% block pageContent %}
    <!-- Filter Bar -->
    <div class="card" style="padding: 16px 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; margin-bottom: 24px; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px;">
        <form method="get" action="{{ cpUrl('spin-to-win/reports') }}" style="display: flex; align-items: center; gap: 12px; margin: 0; flex-wrap: wrap;">
            {% if craft.app.request.getQueryParam('site') %}
                <input type="hidden" name="site" value="{{ craft.app.request.getQueryParam('site') }}">
            {% endif %}
            {% if selectedSiteId and not craft.app.request.getQueryParam('site') %}
                <input type="hidden" name="siteId" value="{{ selectedSiteId }}">
            {% endif %}
            <label for="campaign-filter" style="font-weight: 600; font-size: 13px; color: #475569;">{{ "Filter by Campaign:"|t('spin-to-win') }}</label>
            <select id="campaign-filter" name="campaignId" class="select" onchange="this.form.submit()" style="min-width: 240px; padding: 6px 12px; border: 1px solid #cbd5e1; border-radius: 6px; font-size: 13px;">
                <option value="">{{ "All Campaigns"|t('spin-to-win') }}</option>
                {% for c in allCampaigns %}
                    <option value="{{ c.id }}" {% if campaignId == c.id %}selected{% endif %}>{{ c.name }}</option>
                {% endfor %}
            </select>
            {% if campaignId %}
                <a href="{{ cpUrl('spin-to-win/reports', craft.app.request.getQueryParam('site') ? { site: craft.app.request.getQueryParam('site') } : {}) }}" class="btn small">{{ "Clear Filter"|t('spin-to-win') }}</a>
            {% endif %}
        </form>

        <div style="font-size: 12px; color: #64748b;">
            {% if isProEdition %}
                <span style="display: inline-flex; align-items: center; gap: 4px; color: #059669; font-weight: 600;">
                    <span style="width: 8px; height: 8px; border-radius: 50%; background: #10b981;"></span>
                    {{ "Pro Edition Active - Full Reports & Export Unlocked"|t('spin-to-win') }}
                </span>
            {% else %}
                <span style="color: #64748b;">{{ "Lite Edition - Upgrade to Pro for CSV exports & automated webhooks"|t('spin-to-win') }}</span>
            {% endif %}
        </div>
    </div>

    <!-- Metrics Overview -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 16px; margin-bottom: 24px;">
        <div class="card" style="padding: 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #64748b;">{{ "Total Spins"|t('spin-to-win') }}</div>
            <div style="font-size: 28px; font-weight: 700; color: #0f172a; margin-top: 6px;">{{ stats.totalSpins|number_format }}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 4px;">{{ "Recorded spin attempts"|t('spin-to-win') }}</div>
        </div>

        <div class="card" style="padding: 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #64748b;">{{ "Winning Outcomes"|t('spin-to-win') }}</div>
            <div style="font-size: 28px; font-weight: 700; color: #10b981; margin-top: 6px;">{{ stats.totalWins|number_format }}</div>
            <div style="font-size: 12px; color: #059669; font-weight: 600; margin-top: 4px;">{{ stats.winRate }}% {{ "Win Rate"|t('spin-to-win') }}</div>
        </div>

        <div class="card" style="padding: 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #64748b;">{{ "Coupons Issued"|t('spin-to-win') }}</div>
            <div style="font-size: 28px; font-weight: 700; color: #0284c7; margin-top: 6px;">{{ stats.totalCoupons|number_format }}</div>
            <div style="font-size: 12px; color: #64748b; margin-top: 4px;">{{ "Single-use Commerce codes"|t('spin-to-win') }}</div>
        </div>

        <div class="card" style="padding: 20px; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="font-size: 11px; font-weight: 600; text-transform: uppercase; color: #64748b;">{{ "Commerce Redemptions"|t('spin-to-win') }}</div>
            <div style="font-size: 28px; font-weight: 700; color: #6366f1; margin-top: 6px;">{{ stats.redeemedCoupons|number_format }}</div>
            <div style="font-size: 12px; color: #4338ca; font-weight: 600; margin-top: 4px;">{{ stats.redemptionRate }}% {{ "Redemption Rate"|t('spin-to-win') }}</div>
        </div>
    </div>

    <!-- Conversion Funnel -->
    <div class="card" style="background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04); margin-bottom: 24px;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
            <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #0f172a;">{{ "Customer Conversion Funnel"|t('spin-to-win') }}</h3>
            <p style="margin: 4px 0 0; font-size: 12px; color: #64748b;">{{ "Tracks customer drop-off from widget trigger to order completion"|t('spin-to-win') }}</p>
        </div>

        <div style="padding: 24px; display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px;">
            {% for step in funnel %}
                <div style="background: #f8fafc; border: 1px solid #e2e8f0; border-radius: 8px; padding: 16px; position: relative;">
                    <div style="font-size: 12px; font-weight: 700; color: #334155; margin-bottom: 6px;">{{ step.stage }}</div>
                    <div style="font-size: 24px; font-weight: 700; color: #0f172a;">{{ step.count|number_format }}</div>
                    <div style="margin-top: 8px; font-size: 11px; color: #64748b; line-height: 1.4;">{{ step.description }}</div>
                    <div style="margin-top: 12px;">
                        <div style="height: 6px; background: #e2e8f0; border-radius: 3px; overflow: hidden;">
                            <div style="height: 100%; width: {{ step.conversionRate }}%; background: #4f46e5; border-radius: 3px;"></div>
                        </div>
                        <div style="font-size: 11px; font-weight: 600; color: #4f46e5; margin-top: 4px; text-align: right;">{{ step.conversionRate }}%</div>
                    </div>
                </div>
            {% endfor %}
        </div>
    </div>

    <!-- Probability Spin Pool & Prize Quotas Table -->
    <div class="card" style="background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04); margin-bottom: 24px;">
        <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0; display: flex; justify-content: space-between; align-items: center;">
            <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #0f172a;">{{ "Prize Pool Quotas & Awarded Allocations"|t('spin-to-win') }}</h3>
            <span style="font-size: 12px; color: #64748b;">{{ "Formula: Probability = (Prizes / Pool) × 100"|t('spin-to-win') }}</span>
        </div>

        {% if segmentBreakdown|length %}
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Campaign"|t('spin-to-win') }}</th>
                        <th>{{ "Segment / Prize"|t('spin-to-win') }}</th>
                        <th>{{ "Prize Type"|t('spin-to-win') }}</th>
                        <th>{{ "Mode"|t('spin-to-win') }}</th>
                        <th>{{ "Prizes in Pool"|t('spin-to-win') }}</th>
                        <th>{{ "Calculated Probability"|t('spin-to-win') }}</th>
                        <th>{{ "Awarded (Current Pool)"|t('spin-to-win') }}</th>
                        <th>{{ "Remaining Quota"|t('spin-to-win') }}</th>
                        <th>{{ "Lifetime Wins"|t('spin-to-win') }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for seg in segmentBreakdown %}
                        {% set prob = seg.spinPoolSize > 0 ? ((seg.allocatedCount / seg.spinPoolSize) * 100)|round(3) : 0 %}
                        {% set remaining = (seg.allocatedCount - seg.poolAwardedCount)|default(0) %}
                        <tr>
                            <td><strong>{{ seg.campaignName }}</strong></td>
                            <td>{{ seg.label }}</td>
                            <td><span class="badge" style="background: #f1f5f9; color: #475569; font-size: 11px;">{{ seg.rewardType|title }}</span></td>
                            <td>
                                {% if seg.allocationMode == 'quota_guaranteed' %}
                                    <span style="font-size: 11px; font-weight: 700; color: #047857; background: #ecfdf5; padding: 2px 6px; border-radius: 4px;">{{ "Guaranteed Quota"|t('spin-to-win') }}</span>
                                {% else %}
                                    <span style="font-size: 11px; font-weight: 700; color: #b45309; background: #fef3c7; padding: 2px 6px; border-radius: 4px;">{{ "Random Roll"|t('spin-to-win') }}</span>
                                {% endif %}
                            </td>
                            <td><strong>{{ seg.allocatedCount|number_format }}</strong> / {{ seg.spinPoolSize|number_format }}</td>
                            <td>
                                <span style="font-weight: 700; color: #4338ca;">{{ prob }}%</span>
                            </td>
                            <td>{{ seg.poolAwardedCount|default(0)|number_format }}</td>
                            <td>
                                {% if remaining <= 0 and seg.allocationMode == 'quota_guaranteed' %}
                                    <span style="color: #ef4444; font-weight: 700;">{{ "0 (Exhausted)"|t('spin-to-win') }}</span>
                                {% else %}
                                    <span style="color: #10b981; font-weight: 600;">{{ remaining|number_format }}</span>
                                {% endif %}
                            </td>
                            <td>{{ seg.awardedCount|default(0)|number_format }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% else %}
            <div style="padding: 24px 20px; text-align: center; color: #64748b;">
                <p style="margin: 0;">{{ "No segments configured yet."|t('spin-to-win') }}</p>
            </div>
        {% endif %}
    </div>

    <!-- Reward Distribution & Activity Grid -->
    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 24px;">
        <!-- Reward Outcome Breakdown -->
        <div class="card" style="background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #0f172a;">{{ "Reward Outcome Breakdown"|t('spin-to-win') }}</h3>
            </div>

            {% if rewardBreakdown|length %}
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>{{ "Reward Type"|t('spin-to-win') }}</th>
                            <th>{{ "Wins Awarded"|t('spin-to-win') }}</th>
                            <th>{{ "Percentage of Wins"|t('spin-to-win') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for row in rewardBreakdown %}
                            {% set pct = stats.totalWins > 0 ? ((row.count / stats.totalWins) * 100)|round(1) : 0 %}
                            <tr>
                                <td><strong>{{ row.rewardType|title }}</strong></td>
                                <td>{{ row.count }}</td>
                                <td>
                                    <div style="display: flex; align-items: center; gap: 8px;">
                                        <div style="flex: 1; max-width: 120px; height: 8px; background: #f1f5f9; border-radius: 4px; overflow: hidden;">
                                            <div style="width: {{ pct }}%; height: 100%; background: #3b82f6;"></div>
                                        </div>
                                        <span style="font-size: 12px; color: #64748b;">{{ pct }}%</span>
                                    </div>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div style="padding: 36px 20px; text-align: center; color: #64748b;">
                    <p style="margin: 0;">{{ "No prize data recorded yet."|t('spin-to-win') }}</p>
                </div>
            {% endif %}
        </div>

        <!-- Recent 14-Day Activity -->
        <div class="card" style="background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="padding: 16px 20px; border-bottom: 1px solid #e2e8f0;">
                <h3 style="margin: 0; font-size: 15px; font-weight: 600; color: #0f172a;">{{ "Recent Daily Activity (Last 14 Days)"|t('spin-to-win') }}</h3>
            </div>

            {% if dailyActivity|length %}
                <table class="data fullwidth">
                    <thead>
                        <tr>
                            <th>{{ "Date"|t('spin-to-win') }}</th>
                            <th>{{ "Total Spins"|t('spin-to-win') }}</th>
                            <th>{{ "Winning Spins"|t('spin-to-win') }}</th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for day in dailyActivity|reverse|slice(0, 7) %}
                            <tr>
                                <td><strong>{{ day.date }}</strong></td>
                                <td>{{ day.spins }}</td>
                                <td>
                                    {% if day.wins > 0 %}
                                        <span style="color: #059669; font-weight: 600;">{{ day.wins }}</span>
                                    {% else %}
                                        <span style="color: #94a3b8;">0</span>
                                    {% endif %}
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            {% else %}
                <div style="padding: 36px 20px; text-align: center; color: #64748b;">
                    <p style="margin: 0;">{{ "No daily activity recorded in this period."|t('spin-to-win') }}</p>
                </div>
            {% endif %}
        </div>
    </div>
{% endblock %}
