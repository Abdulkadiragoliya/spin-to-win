{% extends "spin-to-win/_layouts/cp" %}

{% set selectedSubnavItem = 'campaigns' %}
{% set title = 'Campaigns'|t('spin-to-win') %}

{% set allSites = craft.app.sites.getAllSites() %}
{% set isMultiSite = allSites|length > 1 %}
{% set currentSiteHandle = craft.app.request.getQueryParam('site') %}
{% set activeSite = selectedSiteId ? craft.app.sites.getSiteById(selectedSiteId) : (currentSiteHandle ? craft.app.sites.getSiteByHandle(currentSiteHandle) : null) %}

{% block actionButton %}
    <a href="{{ cpUrl('spin-to-win/campaigns/new', activeSite ? { siteId: activeSite.id } : {}) }}" class="btn submit add icon">
        {{ activeSite ? ('New Campaign for ' ~ activeSite.name)|t('spin-to-win') : 'New Campaign'|t('spin-to-win') }}
    </a>
{% endblock %}

{% block pageContent %}
    {% set isProEdition = isPro ?? isPlus ?? false %}
    {% if isMultiSite %}
        <!-- Multi-Site Filter Bar -->
        <div class="card" style="margin-bottom: 20px; padding: 12px 18px; background: #ffffff; border-radius: 10px; border: 1px solid #e2e8f0; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 14px; box-shadow: 0 1px 2px rgba(0,0,0,0.03);">
            <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
                <span style="font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: #64748b; display: inline-flex; align-items: center; gap: 6px;">
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#64748b" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                    {{ "Storefront:"|t('spin-to-win') }}
                </span>
                <div style="display: inline-flex; align-items: center; background: #f1f5f9; padding: 3px; border-radius: 9999px; border: 1px solid #e2e8f0; gap: 2px;">
                    <a href="{{ cpUrl('spin-to-win/campaigns') }}" 
                       style="display: inline-flex; align-items: center; gap: 5px; padding: 5px 14px; border-radius: 9999px; font-size: 12px; font-weight: {{ not activeSite ? '700' : '500' }}; text-decoration: none; transition: all 0.15s ease; {{ not activeSite ? 'background: #0f172a; color: #ffffff; box-shadow: 0 1px 2px rgba(0,0,0,0.1);' : 'color: #475569;' }}">
                        <span>🌐</span>
                        <span>{{ "All Sites"|t('spin-to-win') }}</span>
                    </a>
                    {% for s in allSites %}
                        {% set isSel = activeSite and activeSite.id == s.id %}
                        <a href="{{ cpUrl('spin-to-win/campaigns', { site: s.handle }) }}" 
                           style="display: inline-flex; align-items: center; gap: 5px; padding: 5px 14px; border-radius: 9999px; font-size: 12px; font-weight: {{ isSel ? '700' : '500' }}; text-decoration: none; transition: all 0.15s ease; {{ isSel ? 'background: #4f46e5; color: #ffffff; box-shadow: 0 1px 3px rgba(79,70,229,0.3);' : 'color: #475569;' }}">
                            <span>🏬</span>
                            <span>{{ s.name }}</span>
                        </a>
                    {% endfor %}
                </div>
            </div>

            <div>
                {% if isProEdition %}
                    <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: #047857; background: #ecfdf5; border: 1px solid #a7f3d0; padding: 4px 10px; border-radius: 9999px;">
                        <span style="width: 7px; height: 7px; border-radius: 50%; background: #10b981;"></span>
                        {{ "Pro Multi-Site Active"|t('spin-to-win') }}
                    </span>
                {% else %}
                    <span style="display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 600; color: #92400e; background: #fffbeb; border: 1px solid #fde68a; padding: 4px 12px; border-radius: 9999px;">
                        <span>🔒</span>
                        <span>{{ "Lite Edition: Multi-site targeting unlocked in Pro"|t('spin-to-win') }}</span>
                    </span>
                {% endif %}
            </div>
        </div>
    {% endif %}

    {% if campaigns|length %}
        <div class="card" style="background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; overflow: hidden; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <table class="data fullwidth">
                <thead>
                    <tr>
                        <th>{{ "Name"|t('spin-to-win') }}</th>
                        <th>{{ "Handle"|t('spin-to-win') }}</th>
                        {% if isMultiSite %}
                            <th>{{ "Target Site"|t('spin-to-win') }}</th>
                        {% endif %}
                        <th>{{ "Mode"|t('spin-to-win') }}</th>
                        <th>{{ "Status"|t('spin-to-win') }}</th>
                        <th>{{ "Schedule"|t('spin-to-win') }}</th>
                        <th>{{ "Date Created"|t('spin-to-win') }}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {% for campaign in campaigns %}
                        <tr>
                            <td>
                                <strong><a href="{{ cpUrl('spin-to-win/campaigns/' ~ campaign.id) }}">{{ campaign.name }}</a></strong>
                                {% if campaign.description %}
                                    <div style="font-size: 12px; color: #64748b; margin-top: 2px;">{{ campaign.description }}</div>
                                {% endif %}
                            </td>
                            <td><code>{{ campaign.handle }}</code></td>
                            {% if isMultiSite %}
                                <td>
                                    {% if campaign.siteId %}
                                        {% set targetSite = craft.app.sites.getSiteById(campaign.siteId) %}
                                        <span class="badge" style="background: #e0e7ff; color: #4338ca; padding: 2px 8px; border-radius: 4px; font-size: 11px; font-weight: 600;">
                                            {{ targetSite ? targetSite.name : ('Site #' ~ campaign.siteId) }}
                                        </span>
                                    {% else %}
                                        <span class="badge" style="background: #f1f5f9; color: #64748b; padding: 2px 8px; border-radius: 4px; font-size: 11px;">
                                            {{ "All Sites (Global)"|t('spin-to-win') }}
                                        </span>
                                    {% endif %}
                                </td>
                            {% endif %}
                            <td>
                                <span class="badge" style="background: #f1f5f9; color: #475569; padding: 2px 8px; border-radius: 4px; font-size: 12px;">
                                    {{ campaign.displayMode|capitalize }}
                                </span>
                            </td>
                            <td>
                                {% if campaign.enabled %}
                                    <span class="status green"></span> {{ "Active"|t('spin-to-win') }}
                                {% else %}
                                    <span class="status grey"></span> {{ "Paused"|t('spin-to-win') }}
                                {% endif %}
                            </td>
                            <td>
                                {% if campaign.startDate or campaign.endDate %}
                                    <div style="font-size: 12px; color: #334155;">
                                        {{ campaign.startDate ? campaign.startDate|date('short') : 'Anytime' }} → {{ campaign.endDate ? campaign.endDate|date('short') : 'Ongoing' }}
                                    </div>
                                {% else %}
                                    <span style="color: #94a3b8; font-size: 12px;">{{ "Always active"|t('spin-to-win') }}</span>
                                {% endif %}
                            </td>
                            <td>{{ campaign.dateCreated|datetime('short') }}</td>
                            <td class="thin">
                                <a href="{{ cpUrl('spin-to-win/campaigns/' ~ campaign.id) }}" class="btn small">{{ "Edit"|t('app') }}</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% else %}
        <div class="card" style="padding: 48px 24px; text-align: center; background: #fff; border-radius: 8px; border: 1px solid #e2e8f0; box-shadow: 0 1px 2px rgba(0,0,0,0.04);">
            <div style="max-width: 440px; margin: 0 auto;">
                <div style="width: 56px; height: 56px; line-height: 56px; border-radius: 50%; background: #eff6ff; color: #3b82f6; margin: 0 auto 16px; font-size: 24px;">🎡</div>
                <h3 style="font-size: 18px; font-weight: 600; color: #0f172a; margin: 0 0 8px;">
                    {{ activeSite ? ('No campaigns configured for ' ~ activeSite.name)|t('spin-to-win') : "No campaigns configured yet"|t('spin-to-win') }}
                </h3>
                <p style="font-size: 14px; color: #64748b; margin: 0 0 24px; line-height: 1.5;">
                    {{ "Create your promotional prize wheel campaign. Configure segment weights, discounts, triggers, and appearance."|t('spin-to-win') }}
                </p>
                <a href="{{ cpUrl('spin-to-win/campaigns/new', activeSite ? { siteId: activeSite.id } : {}) }}" class="btn submit big">
                    {{ activeSite ? ('Create Campaign for ' ~ activeSite.name)|t('spin-to-win') : "Create New Campaign"|t('spin-to-win') }}
                </a>
            </div>
        </div>
    {% endif %}
{% endblock %}
