                <!-- Form & Text Section (Right) -->
                <div class="stw-sidebar-copy-wrap">
                    <!-- Form Panel -->
                    <div class="stw-form-panel">
                        <h3 class="stw-headline">{{ campaign.welcomeTitle|default('Spin to Win Holiday Discounts!') }}</h3>
                        <p class="stw-subtext">{{ campaign.welcomeText|default('Enter your email for a chance to win up to 25% off.') }}</p>

                        <div class="stw-error-alert" style="margin-top: 8px;"></div>

                        <form class="stw-spin-form" onsubmit="event.preventDefault(); window['stwWidget_{{ campaign.handle }}'].spin();" style="display: flex; flex-direction: column; gap: 12px; margin-top: 14px;">
                            <input type="hidden" name="action" value="spin-to-win/spin/execute">
                            <input type="hidden" name="campaignHandle" value="{{ campaign.handle }}">
                            <input type="hidden" name="{{ csrfTokenName }}" value="{{ csrfTokenValue }}">

                            {% if campaign.requireName %}
                                <input type="text" name="name" class="stw-input-field stw-field-name" placeholder="{{ 'Your Name'|t('spin-to-win') }}" required>
