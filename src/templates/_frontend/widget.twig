                        <div class="stw-coupon-box">
                            <div class="stw-coupon-code">WIN-CODE</div>
                            <div style="display: flex; gap: 8px; justify-content: center; flex-wrap: wrap; margin-top: 8px;">
                                <button type="button" class="stw-copy-btn" onclick="window['stwWidget_{{ campaign.handle }}'].copyCoupon(this)">
                                    <span>{{ "Copy Code"|t('spin-to-win') }}</span>
                                </button>
                                <button type="button" class="stw-apply-cart-btn" onclick="window['stwWidget_{{ campaign.handle }}'].applyToCart(this)" style="display: none;">
                                    <span>{{ "Apply to Cart"|t('spin-to-win') }}</span>
                                </button>
                            </div>
                            <div class="stw-cart-feedback" style="display: none; font-size: 12px; color: #166534; font-weight: 600; margin-top: 8px;"></div>
