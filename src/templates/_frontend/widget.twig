{# Spin to Win Storefront Widget #}
{% set displayMode = options.displayMode ?? campaign.displayMode|default('popup') %}
{% set sidebarPosition = options.sidebarPosition ?? wheelSettings.sidebarPosition|default('left') %}
{% set triggerType = options.triggerType ?? campaign.triggerType|default('load') %}
{% set triggerDelay = options.triggerDelay ?? campaign.triggerDelay|default(0) %}
{% set scrollThreshold = options.scrollThreshold ?? campaign.scrollThreshold|default(0) %}
{% set widgetId = 'stw-' ~ campaign.handle ~ '-' ~ random() %}
{% set csrfTokenName = craft.app.config.general.csrfTokenName|default('CRAFT_CSRF_TOKEN') %}
{% set csrfTokenValue = craft.app.request.csrfToken|default('') %}

{% set completedCookie = craft.app.request.cookies.get('stw_completed_' ~ campaign.handle) %}
{% set forceTest = craft.app.request.getQueryParam('test_spin') or craft.app.request.getQueryParam('spin') == 'force' or craft.app.request.getQueryParam('spin') == '1' %}
{% if not completedCookie or forceTest %}

<div id="{{ widgetId }}" class="stw-widget-root stw-mode-{{ displayMode }} stw-sidebar-{{ sidebarPosition }}" data-handle="{{ campaign.handle }}" data-mode="{{ displayMode }}" data-sidebar-pos="{{ sidebarPosition }}" data-trigger="{{ triggerType }}" data-delay="{{ triggerDelay }}" data-scroll="{{ scrollThreshold }}">
    <style>
        /* Scoped Spin to Win Widget Styles */
        #{{ widgetId }} {
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
            color: {{ wheelSettings.headlineColor|default('#0f172a') }};
            box-sizing: border-box;
            z-index: 999999;
            pointer-events: none;
            --stw-panel-bg: {{ wheelSettings.panelBgColor|default('#ffffff') }};
            --stw-headline-color: {{ wheelSettings.headlineColor|default('#0f172a') }};
            --stw-subtext-color: {{ wheelSettings.subtextColor|default('#64748b') }};
            --stw-input-bg: {{ wheelSettings.inputBgColor|default('#ffffff') }};
            --stw-input-border: {{ wheelSettings.inputBorderColor|default('#cbd5e1') }};
            --stw-input-text: {{ wheelSettings.inputTextColor|default('#0f172a') }};
            --stw-btn-bg: {{ wheelSettings.buttonBgColor|default('#4f46e5') }};
            --stw-btn-text: {{ wheelSettings.buttonTextColor|default('#ffffff') }};
        }
        #{{ widgetId }} * {
            box-sizing: border-box;
        }
        /* Backdrop for Modal Popup */
        #{{ widgetId }} .stw-backdrop {
            position: fixed;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: rgba(15, 23, 42, 0.65);
            backdrop-filter: blur(4px);
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.3s ease;
            z-index: 999998;
        }
        #{{ widgetId }}.stw-active .stw-backdrop {
            opacity: 1;
            pointer-events: auto;
        }
        /* Modal Popup Card */
        #{{ widgetId }} .stw-modal-card {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -46%) scale(0.95);
            background: var(--stw-panel-bg, #ffffff);
            border-radius: 24px;
            box-shadow: 0 25px 65px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.06);
            width: 95%;
            max-width: 980px; /* Big desktop modal */
            min-height: 520px;
            max-height: 94vh;
            overflow: hidden;
            z-index: 999999;
            opacity: 0;
            pointer-events: none;
            transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
            display: flex;
            flex-direction: column;
            padding: 0;
            box-sizing: border-box;
        }
        #{{ widgetId }}.stw-active .stw-modal-card {
            transform: translate(-50%, -50%) scale(1);
            opacity: 1;
            pointer-events: auto;
        }

        /* Slide-in Sidebar Panel: Horizontal Half-Wheel Desktop Drawer */
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-panel {
            position: fixed;
            top: 50%;
            left: 0;
            transform: translate(-105%, -50%);
            background: var(--stw-panel-bg, #ffffff);
            border-radius: 0 24px 24px 0;
            box-shadow: 0 25px 65px -12px rgba(0, 0, 0, 0.35), 0 0 0 1px rgba(0, 0, 0, 0.06);
            z-index: 999999;
            opacity: 0;
            pointer-events: none;
            transition: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
            overflow: hidden;
            display: flex;
            align-items: center;
            max-width: calc(100vw - 20px);
        }
        #{{ widgetId }}.stw-active.stw-mode-sidebar .stw-sidebar-panel {
            transform: translate(0, -50%);
            opacity: 1;
            pointer-events: auto;
        }

        /* Right Side Desktop Sidebar */
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-panel {
            left: auto;
            right: 0;
            transform: translate(105%, -50%);
            border-radius: 24px 0 0 24px;
        }
        #{{ widgetId }}.stw-active.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-panel {
            transform: translate(0, -50%);
        }
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-grid {
            flex-direction: row-reverse;
        }
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-wheel-side {
            left: auto;
            right: -130px;
        }
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
            left: auto;
            right: 308px;
            transform: translateY(-50%) rotate(180deg);
        }
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-horizontal.ticking {
            transform: translateY(-50%) rotate(180deg) scale(1.15) rotate(8deg);
        }
        #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-close-btn {
            right: auto;
            left: 16px;
        }

        /* Top Slide-down Sidebar for Desktop (min-width: 769px): Big 440px Wheel & Centered Layout */
        @media (min-width: 769px) {
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-panel {
                top: 0 !important;
                left: 50% !important;
                right: auto !important;
                transform: translate(-50%, -110%) !important;
                border-radius: 0 0 24px 24px !important;
                width: 92% !important;
                max-width: 540px !important;
                max-height: calc(100vh - 28px) !important;
                overflow-y: auto !important;
                box-shadow: 0 25px 65px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(0, 0, 0, 0.08) !important;
            }
            #{{ widgetId }}.stw-active.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-panel {
                transform: translate(-50%, 0) !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-grid {
                flex-direction: column !important;
                align-items: center !important;
                padding: 24px 24px 30px 24px !important;
                min-height: auto !important;
                width: 100% !important;
                text-align: center !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap {
                width: 450px !important;
                height: 450px !important;
                justify-content: center !important;
                margin: 0 auto !important;
                position: relative !important;
                overflow: visible !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-wheel-side {
                position: relative !important;
                left: auto !important;
                right: auto !important;
                top: auto !important;
                transform: none !important;
                width: 440px !important;
                height: 440px !important;
                margin: 10px auto 0 auto !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-svg {
                width: 440px !important;
                height: 440px !important;
            }
            /* Top Slide-down Pin: Native vertical pointer at 12 o'clock center starting from top of circle */
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
                display: none !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-vertical {
                display: block !important;
                position: absolute !important;
                top: -6px !important;
                left: 50% !important;
                transform: translateX(-50%) !important;
                transform-origin: 16px 8px !important;
                width: 32px !important;
                height: 42px !important;
                z-index: 35 !important;
                filter: drop-shadow(0 3px 5px rgba(0,0,0,0.35)) !important;
                transition: transform 0.1s ease !important;
                pointer-events: none !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-vertical.ticking {
                transform: translateX(-50%) scale(1.15) rotate(6deg) !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-copy-wrap {
                width: 100% !important;
                max-width: 460px !important;
                padding: 16px 0 0 0 !important;
                text-align: center !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-close-btn {
                top: 14px !important;
                right: 14px !important;
                left: auto !important;
            }
        }

        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-grid {
            display: flex;
            flex-direction: row;
            align-items: center;
            position: relative;
            box-sizing: border-box;
            padding: 0;
            min-height: 480px;
        }

        /* Left Section: Big Half Wheel & 3 o'clock Pointer Directly Touching Rim */
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap {
            position: relative;
            width: 330px;
            height: 480px;
            flex-shrink: 0;
            overflow: visible;
            display: flex;
            align-items: center;
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-wheel-side {
            position: absolute;
            left: -130px;
            top: 50%;
            transform: translateY(-50%);
            width: 460px;
            height: 460px;
            display: flex;
            align-items: center;
            justify-content: center;
            user-select: none;
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-svg {
            width: 460px !important;
            height: 460px !important;
            filter: drop-shadow(0 6px 16px rgba(0,0,0,0.18));
        }
        /* Right-pointing-left ticker at 3 o'clock directly touching outer wheel rim with zero gap */
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
            position: absolute;
            left: 308px;
            right: auto;
            top: 50%;
            transform: translateY(-50%);
            width: 36px;
            height: 28px;
            z-index: 30;
            filter: drop-shadow(0 3px 6px rgba(0,0,0,0.35));
            transform-origin: 32px 14px;
            transition: transform 0.1s ease;
            pointer-events: none;
            display: block;
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-horizontal.ticking {
            transform: translateY(-50%) scale(1.15) rotate(-8deg);
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-vertical {
            display: none;
        }

        /* Right Section: Copy & Form */
        #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-copy-wrap {
            padding: 40px 40px 40px 18px;
            width: 350px;
            max-width: 390px;
            box-sizing: border-box;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-headline {
            font-size: 23px;
            font-weight: 800;
            line-height: 1.25;
            color: var(--stw-headline-color, #0f172a);
            margin: 0 0 6px;
            letter-spacing: -0.02em;
        }
        #{{ widgetId }}.stw-mode-sidebar .stw-subtext {
            font-size: 13px;
            line-height: 1.45;
            color: var(--stw-subtext-color, #64748b);
            margin: 0;
        }

        /* Tablet Responsive Layout (769px to 1024px) */
        @media (min-width: 769px) and (max-width: 1024px) {
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-panel {
                max-width: 630px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap {
                width: 290px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-wheel-side {
                left: -130px !important;
                width: 420px !important;
                height: 420px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-svg {
                width: 420px !important;
                height: 420px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
                left: 280px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-wheel-side {
                left: auto !important;
                right: -130px !important;
            }
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
                right: 280px !important;
                left: auto !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-copy-wrap {
                padding: 30px 28px 30px 16px !important;
                width: 320px !important;
            }
        }

        /* Mobile Responsive Drawer (All Mobile Devices: Top Slide-down Stacked View) */
        @media (max-width: 768px) {
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-panel,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-panel,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-panel,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-panel {
                top: 16px !important;
                left: 50% !important;
                right: auto !important;
                bottom: auto !important;
                width: calc(100vw - 28px) !important;
                max-width: 380px !important;
                max-height: calc(100vh - 32px) !important;
                border-radius: 20px !important;
                margin: 0 !important;
                transform: translate(-50%, -140%) !important;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
                overflow-y: auto !important;
                box-sizing: border-box !important;
            }
            #{{ widgetId }}.stw-active.stw-mode-sidebar .stw-sidebar-panel,
            #{{ widgetId }}.stw-active.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-panel,
            #{{ widgetId }}.stw-active.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-panel,
            #{{ widgetId }}.stw-active.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-panel {
                transform: translate(-50%, 0) !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-grid,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-grid,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-grid,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-grid {
                flex-direction: column !important;
                padding: 20px 16px 24px 16px !important;
                min-height: auto !important;
                width: 100% !important;
                box-sizing: border-box !important;
                align-items: center !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap {
                width: 260px !important;
                height: 260px !important;
                justify-content: center !important;
                margin: 0 auto !important;
                position: relative !important;
                overflow: visible !important;
                box-sizing: border-box !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-wheel-side,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap .stw-wheel-side,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-wheel-side,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-wheel-side {
                position: relative !important;
                left: auto !important;
                right: auto !important;
                top: auto !important;
                transform: none !important;
                width: 250px !important;
                height: 250px !important;
                margin: 8px auto 0 auto !important;
                box-sizing: border-box !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-svg,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap .stw-svg,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-svg,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-svg {
                width: 250px !important;
                height: 250px !important;
                display: block !important;
                margin: 0 auto !important;
            }
            /* Pin on Mobile: Native vertical pointer at 12 o'clock center starting from top of circle */
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-horizontal,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap .stw-pointer-horizontal,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-horizontal,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-horizontal {
                display: none !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-vertical,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap .stw-pointer-vertical,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-vertical,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-vertical {
                display: block !important;
                position: absolute !important;
                top: -4px !important;
                left: 50% !important;
                transform: translateX(-50%) !important;
                transform-origin: 14px 6px !important;
                width: 28px !important;
                height: 36px !important;
                z-index: 35 !important;
                filter: drop-shadow(0 3px 5px rgba(0,0,0,0.35)) !important;
                transition: transform 0.1s ease !important;
                pointer-events: none !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-wheel-wrap .stw-pointer-vertical.ticking,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-wheel-wrap .stw-pointer-vertical.ticking,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-wheel-wrap .stw-pointer-vertical.ticking,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-wheel-wrap .stw-pointer-vertical.ticking {
                transform: translateX(-50%) scale(1.15) rotate(6deg) !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-sidebar-copy-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-sidebar-copy-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-sidebar-copy-wrap,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-sidebar-copy-wrap {
                width: 100% !important;
                max-width: 100% !important;
                padding: 12px 14px 18px 14px !important;
                box-sizing: border-box !important;
                text-align: center !important;
            }
            #{{ widgetId }}.stw-mode-sidebar .stw-close-btn,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-left .stw-close-btn,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-right .stw-close-btn,
            #{{ widgetId }}.stw-mode-sidebar.stw-sidebar-top .stw-close-btn {
                position: absolute !important;
                top: 12px !important;
                right: 12px !important;
                left: auto !important;
                width: 32px !important;
                height: 32px !important;
                z-index: 50 !important;
            }
        }

        /* Close Button */
        #{{ widgetId }} .stw-close-btn {
            position: absolute;
            top: 16px;
            right: 16px;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: #f1f5f9;
            border: none;
            color: #64748b;
            font-size: 22px;
            line-height: 1;
            cursor: pointer;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.15s ease;
            z-index: 50;
        }
        #{{ widgetId }} .stw-close-btn:hover {
            background: #e2e8f0;
            color: #0f172a;
        }
        /* Desktop Modal Popup: 2-column layout with big wheel filling left section and form on right */
        #{{ widgetId }}.stw-mode-popup .stw-content-grid {
            display: grid;
            grid-template-columns: 500px 1fr;
            align-items: center;
            width: 100%;
            min-height: 520px;
            gap: 0;
        }
        /* Modal Wheel Container (Left section filling specified area with big wheel) */
        #{{ widgetId }}.stw-mode-popup .stw-wheel-side {
            position: relative;
            width: 500px;
            height: 520px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 24px;
            box-sizing: border-box;
            background: radial-gradient(circle at center, #f8fafc 0%, #f1f5f9 100%);
            border-right: 1px solid #f1f5f9;
            user-select: none;
        }
        #{{ widgetId }}.stw-mode-popup .stw-wheel-side .stw-svg {
            width: 460px;
            height: 460px;
        }
        #{{ widgetId }}.stw-mode-popup .stw-wheel-side .stw-pointer {
            position: absolute;
            top: 10px;
            left: 50%;
            transform: translateX(-50%);
            width: 32px;
            height: 42px;
            z-index: 25;
            filter: drop-shadow(0 3px 5px rgba(0,0,0,0.35));
            transition: transform 0.1s ease;
        }
        #{{ widgetId }} .stw-pointer.ticking {
            transform: translateX(-50%) scale(1.15) rotate(6deg);
        }
        /* Form & Copy Side (Right) */
        #{{ widgetId }} .stw-copy-side {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 16px;
            text-align: left;
            padding: 40px 48px 40px 40px;
            box-sizing: border-box;
        }
        /* Mobile Layout for Modal Popup: 100% Centered horizontally, equal left and right margins */
        @media (max-width: 768px) {
            #{{ widgetId }} .stw-modal-card,
            #{{ widgetId }}.stw-mode-popup .stw-modal-card {
                position: fixed !important;
                top: 16px !important;
                left: 50% !important;
                right: auto !important;
                bottom: auto !important;
                width: calc(100vw - 28px) !important;
                max-width: 380px !important;
                max-height: calc(100vh - 32px) !important;
                border-radius: 20px !important;
                margin: 0 !important;
                transform: translate(-50%, -140%) !important;
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.4) !important;
                padding: 24px 16px 28px 16px !important;
                overflow-y: auto !important;
                box-sizing: border-box !important;
            }
            #{{ widgetId }}.stw-active .stw-modal-card,
            #{{ widgetId }}.stw-active.stw-mode-popup .stw-modal-card {
                transform: translate(-50%, 0) !important;
            }
            #{{ widgetId }} .stw-content-grid,
            #{{ widgetId }}.stw-mode-popup .stw-content-grid {
                display: flex !important;
