    {% else %}
        <!-- Slide-in Sidebar Panel (Half-Wheel Desktop Drawer) -->
        <div class="stw-sidebar-panel">
            <button type="button" class="stw-close-btn" aria-label="Close" onclick="window['stwWidget_{{ campaign.handle }}'].close()">&times;</button>
            <div class="stw-sidebar-grid">
                <!-- Half-Wheel Container (Left) -->
                <div class="stw-sidebar-wheel-wrap">
                    <div class="stw-wheel-side">
                        <svg class="stw-svg" viewBox="0 0 400 400"></svg>
