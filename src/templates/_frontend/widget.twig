</div>

<!-- Scoped JavaScript Engine -->
<script>
(function() {
    const handle = {{ campaign.handle|json_encode|raw }};
    const rootEl = document.getElementById({{ widgetId|json_encode|raw }});
    if (!rootEl) return;

    // Check if test bypass is requested (?spin=1 or ?spin=force or ?test_spin=1)
    const urlParams = new URLSearchParams(window.location.search);
    const forceShow = urlParams.has('test_spin') || urlParams.get('spin') === 'force' || urlParams.get('spin') === '1';

    // Once wheel is spun and coupon copied, it should NOT be shown again on any page
    let hasCompleted = false;
    try {
        hasCompleted = (
            localStorage.getItem('stw_completed_' + handle) === '1' ||
            !!localStorage.getItem('stw_spun_' + handle) ||
            document.cookie.indexOf('stw_completed_' + encodeURIComponent(handle) + '=1') !== -1
        );
    } catch(e) {}

    if (hasCompleted && !forceShow) {
        // Destroy and remove widget from DOM completely so it is never shown again on any page
        rootEl.remove();
        return;
    }

    function markCampaignCompleted() {
        try {
            localStorage.setItem('stw_completed_' + handle, '1');
            localStorage.setItem('stw_spun_' + handle, Date.now().toString());
            document.cookie = 'stw_completed_' + encodeURIComponent(handle) + '=1; path=/; max-age=31536000; SameSite=Lax';
        } catch(e) {}
    }

    const segments = [
        {% for seg in segments %}
            {
                id: {{ seg.id|json_encode|raw }},
                label: {{ seg.label|json_encode|raw }},
                color: {{ seg.color|json_encode|raw }},
                textColor: {{ seg.textColor|json_encode|raw }},
                rewardType: {{ seg.rewardType|json_encode|raw }}
            },
        {% endfor %}
    ];

    const wheelConfig = {
        hubText: {{ wheelSettings.hubText|default('SPIN')|json_encode|raw }},
        hubColor: {{ wheelSettings.hubColor|default('#ffffff')|json_encode|raw }},
        hubTextColor: {{ wheelSettings.hubTextColor|default('#0f172a')|json_encode|raw }},
        rimColor: {{ wheelSettings.rimColor|default('#1e293b')|json_encode|raw }},
        pointerColor: {{ wheelSettings.pointerColor|default('#ef4444')|json_encode|raw }}
    };

    let currentRotation = 0;
    let isSpinning = false;
    let audioCtx = null;

    function playTick() {
        try {
            if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
            if (audioCtx.state === 'suspended') audioCtx.resume();
            const osc = audioCtx.createOscillator();
            const gain = audioCtx.createGain();
            osc.type = 'triangle';
            osc.frequency.setValueAtTime(650, audioCtx.currentTime);
            osc.frequency.exponentialRampToValueAtTime(150, audioCtx.currentTime + 0.04);
            gain.gain.setValueAtTime(0.12, audioCtx.currentTime);
            gain.gain.exponentialRampToValueAtTime(0.001, audioCtx.currentTime + 0.04);
            osc.connect(gain);
            gain.connect(audioCtx.destination);
            osc.start();
            osc.stop(audioCtx.currentTime + 0.04);
        } catch(e) {}
    }

    function renderSvgWheel() {
        const svgs = rootEl.querySelectorAll('.stw-svg');
        const total = segments.length;
        if (total === 0) return;

        const cx = 200, cy = 200, outerR = 194, sliceR = 176, hubR = 46;
        const sliceAngle = 360 / total;
        let html = '';

        // 1. Outer rim
        html += `<circle cx="${cx}" cy="${cy}" r="${outerR}" fill="${wheelConfig.rimColor}" stroke="#ffffff" stroke-width="3"/>`;

        // 2. LED rim dots
        const dots = Math.max(16, total * 3);
        for (let d = 0; d < dots; d++) {
            const rad = (d * (360 / dots)) * (Math.PI / 180);
            const x = cx + (outerR - 9) * Math.cos(rad);
            const y = cy + (outerR - 9) * Math.sin(rad);
            html += `<circle cx="${x.toFixed(2)}" cy="${y.toFixed(2)}" r="3" fill="#ffffff" opacity="0.9"/>`;
        }

        // 3. Slices
        for (let i = 0; i < total; i++) {
            const seg = segments[i];
            const startRad = (i * sliceAngle - 90) * (Math.PI / 180);
            const endRad = ((i + 1) * sliceAngle - 90) * (Math.PI / 180);

            const x1 = cx + sliceR * Math.cos(startRad);
            const y1 = cy + sliceR * Math.sin(startRad);
            const x2 = cx + sliceR * Math.cos(endRad);
            const y2 = cy + sliceR * Math.sin(endRad);

            const largeArc = sliceAngle > 180 ? 1 : 0;
            const pathD = `M ${cx} ${cy} L ${x1.toFixed(2)} ${y1.toFixed(2)} A ${sliceR} ${sliceR} 0 ${largeArc} 1 ${x2.toFixed(2)} ${y2.toFixed(2)} Z`;
            html += `<path d="${pathD}" fill="${seg.color}" stroke="#ffffff" stroke-width="1.5"/>`;

            // Radial Text
            const midDeg = (i * sliceAngle) + (sliceAngle / 2) - 90;
            const tx = cx + (sliceR * 0.62) * Math.cos(midDeg * Math.PI / 180);
            const ty = cy + (sliceR * 0.62) * Math.sin(midDeg * Math.PI / 180);
            const textRot = midDeg + 90;

            let label = seg.label;
            if (label.length > 14) label = label.substring(0, 12) + '…';

            html += `<g transform="translate(${tx.toFixed(2)}, ${ty.toFixed(2)}) rotate(${textRot.toFixed(2)})">
                <text x="0" y="4" text-anchor="middle" fill="${seg.textColor}" font-size="12" font-weight="700" font-family="system-ui, -apple-system, sans-serif" style="user-select: none;">
                    ${label}
                </text>
            </g>`;
        }

        // 4. Center Hub
        html += `
            <circle cx="${cx}" cy="${cy}" r="${hubR + 6}" fill="rgba(0,0,0,0.15)"/>
            <circle cx="${cx}" cy="${cy}" r="${hubR + 2}" fill="${wheelConfig.rimColor}"/>
            <circle cx="${cx}" cy="${cy}" r="${hubR}" fill="${wheelConfig.hubColor}" stroke="#ffffff" stroke-width="2"/>
            <text x="${cx}" y="${cy + 5}" text-anchor="middle" fill="${wheelConfig.hubTextColor}" font-size="14" font-weight="800" font-family="system-ui, -apple-system, sans-serif" letter-spacing="1" style="user-select: none;">
                ${wheelConfig.hubText}
            </text>
        `;

        svgs.forEach(svg => svg.innerHTML = html);
    }

    // Public Widget Controller Instance
    window['stwWidget_' + handle] = {
        open: function() {
            if (hasCompleted && !forceShow) {
                return;
            }
            rootEl.classList.add('stw-active');
            try {
                sessionStorage.removeItem('stw_dismissed_' + handle);
            } catch(e) {}

            // Record impression event
            fetch({{ actionUrl('spin-to-win/spin/record-view')|json_encode|raw }}, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: new URLSearchParams({
                    campaignHandle: handle,
                    {{ csrfTokenName|json_encode|raw }}: {{ csrfTokenValue|json_encode|raw }}
                })
            }).catch(() => {});
        },

        close: function() {
            rootEl.classList.remove('stw-active');
            // Permanently dismiss widget once closed by clicking 'X' or spinning, so it is NEVER shown again on any page
            markCampaignCompleted();
            setTimeout(() => {
                if (!forceShow) {
                    rootEl.remove();
                }
            }, 500);
        },

        copyCoupon: function(btn) {
            const codeEl = rootEl.querySelector('.stw-coupon-code');
            if (!codeEl) return;
            const code = codeEl.textContent.trim();
            if (!code) return;

            const originalHtml = btn.innerHTML;
            const originalBg = btn.style.background;

            const onCopied = function() {
                markCampaignCompleted();
                btn.innerHTML = '<span>' + {{ 'Copied! ✔'|t('spin-to-win')|json_encode|raw }} + '</span>';
                btn.style.background = '#10b981';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.style.background = originalBg || '#4f46e5';
                }, 2200);
            };

            // Modern clipboard API with reliable fallback for HTTP / non-secure contexts
            if (navigator.clipboard && window.isSecureContext) {
                navigator.clipboard.writeText(code).then(onCopied).catch(() => {
                    fallbackCopy(code, onCopied);
                });
            } else {
                fallbackCopy(code, onCopied);
            }

            function fallbackCopy(text, callback) {
                try {
                    const temp = document.createElement('textarea');
                    temp.value = text;
                    temp.setAttribute('readonly', '');
                    temp.style.position = 'fixed';
                    temp.style.top = '-9999px';
                    temp.style.left = '-9999px';
                    document.body.appendChild(temp);
                    temp.focus();
                    temp.select();
                    const success = document.execCommand('copy');
                    document.body.removeChild(temp);
                    if (success) {
                        callback();
                    } else {
                        window.prompt({{ 'Copy your coupon code:'|t('spin-to-win')|json_encode|raw }}, text);
                    }
                } catch(e) {
                    window.prompt({{ 'Copy your coupon code:'|t('spin-to-win')|json_encode|raw }}, text);
                }
            }
        },

        applyToCart: function(btn) {
            const codeEl = rootEl.querySelector('.stw-coupon-code');
            if (!codeEl) return;
            const code = codeEl.textContent.trim();
            if (!code) return;

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span>' + {{ 'Applying...'|t('spin-to-win')|json_encode|raw }} + '</span>';

            const postData = new URLSearchParams({
                action: 'spin-to-win/spin/apply-cart',
                couponCode: code,
                {{ csrfTokenName|json_encode|raw }}: {{ csrfTokenValue|json_encode|raw }}
            });

            fetch({{ actionUrl('spin-to-win/spin/apply-cart')|json_encode|raw }}, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: postData
            })
            .then(res => res.json())
            .then(data => {
                if (data.success) {
                    markCampaignCompleted();
                    btn.classList.add('applied');
                    btn.innerHTML = '<span>' + {{ '✔ Applied to Cart!'|t('spin-to-win')|json_encode|raw }} + '</span>';
                    const feedbacks = rootEl.querySelectorAll('.stw-cart-feedback');
                    feedbacks.forEach(el => {
                        el.textContent = data.message || {{ 'Coupon applied to your cart!'|t('spin-to-win')|json_encode|raw }};
                        el.style.display = 'block';
                    });
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                    alert(data.message || {{ 'Failed to apply coupon to cart.'|t('spin-to-win')|json_encode|raw }});
                }
            })
            .catch(() => {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
                alert({{ 'Could not connect to shopping cart.'|t('spin-to-win')|json_encode|raw }});
            });
        },

        spin: function() {
            if (isSpinning) return;

            const form = rootEl.querySelector('.stw-spin-form');
            const emailInput = rootEl.querySelector('.stw-field-email');
            const nameInput = rootEl.querySelector('.stw-field-name');
            const consentInput = rootEl.querySelector('.stw-field-consent');
            const errorAlert = rootEl.querySelector('.stw-error-alert');
            const submitBtn = rootEl.querySelector('.stw-submit-btn');

            if (errorAlert) errorAlert.style.display = 'none';

            if (!emailInput || !emailInput.value.trim()) {
                if (errorAlert) {
                    errorAlert.textContent = {{ 'Please enter your email address.'|t('spin-to-win')|json_encode|raw }};
                    errorAlert.style.display = 'block';
                }
                return;
            }

            if (consentInput && !consentInput.checked) {
                if (errorAlert) {
                    errorAlert.textContent = {{ 'Please agree to the terms to spin.'|t('spin-to-win')|json_encode|raw }};
                    errorAlert.style.display = 'block';
                }
                return;
            }

            isSpinning = true;
            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.innerHTML = '<span>' + {{ 'Spinning...'|t('spin-to-win')|json_encode|raw }} + '</span>';
            }

            // AJAX request to execute spin
            const postData = new URLSearchParams({
                action: 'spin-to-win/spin/execute',
                campaignHandle: handle,
                email: emailInput.value.trim(),
                name: nameInput ? nameInput.value.trim() : '',
                consent: consentInput ? (consentInput.checked ? '1' : '0') : '1',
                {{ csrfTokenName|json_encode|raw }}: {{ csrfTokenValue|json_encode|raw }}
            });

            fetch({{ actionUrl('spin-to-win/spin/execute')|json_encode|raw }}, {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: postData
            })
            .then(res => res.json())
            .then(data => {
                if (!data.success) {
                    isSpinning = false;
                    if (submitBtn) {
                        submitBtn.disabled = false;
                        submitBtn.innerHTML = '<span>' + {{ campaign.buttonText|default('Spin to Win!')|json_encode|raw }} + '</span>';
                    }
                    if (errorAlert) {
                        errorAlert.textContent = data.message || {{ 'Failed to execute spin. Please try again.'|t('spin-to-win')|json_encode|raw }};
                        errorAlert.style.display = 'block';
                    }
                    return;
                }

                // Server returned winner! Calculate landing angle
                const winnerIndex = data.segmentIndex;
                const total = segments.length;
                const sliceAngle = 360 / total;

                // Landing angle calculation:
                // For modal popup (or mobile top), pointer is at 12 o'clock (0 deg).
                // For desktop sidebar, pointer is at 3 o'clock (90 deg from 12 o'clock).
                const isSidebarDesktop = rootEl.classList.contains('stw-mode-sidebar') && window.innerWidth > 768;
                let pointerAngle = 0;
                if (isSidebarDesktop) {
                    if (rootEl.classList.contains('stw-sidebar-right')) {
                        pointerAngle = 270;
                    } else if (rootEl.classList.contains('stw-sidebar-top')) {
                        pointerAngle = 0;
                    } else {
                        pointerAngle = 90;
                    }
                }
                const sliceCenterAngle = (winnerIndex + 0.5) * sliceAngle;
                const targetLandingAngle = (pointerAngle - sliceCenterAngle + 3600) % 360;

                // Add slight random jitter
                const jitter = (Math.random() - 0.5) * (sliceAngle * 0.7);

                // 6 to 8 full spins
                const fullSpins = (6 + Math.floor(Math.random() * 2)) * 360;
                const finalRotation = currentRotation + fullSpins + (targetLandingAngle - (currentRotation % 360)) + jitter;

                const svgs = rootEl.querySelectorAll('.stw-svg');
                const pointers = rootEl.querySelectorAll('.stw-pointer');
                const durationMs = 4500;

                svgs.forEach(svg => {
                    svg.style.transition = `transform ${durationMs}ms cubic-bezier(0.12, 0.85, 0.2, 1)`;
                    svg.style.transform = `rotate(${finalRotation}deg)`;
                });

                // Ticking feedback
                const startTickTime = Date.now();
                function triggerTick() {
                    const elapsed = Date.now() - startTickTime;
                    const progress = elapsed / durationMs;
                    if (progress >= 1) return;

                    playTick();
                    if (pointers.length) {
                        pointers.forEach(p => p.classList.add('ticking'));
                        setTimeout(() => pointers.forEach(p => p.classList.remove('ticking')), 60);
                    }

                    const nextDelay = 50 + Math.pow(progress, 3) * 350;
                    if (progress < 0.98) {
                        setTimeout(triggerTick, nextDelay);
                    }
                }
                setTimeout(triggerTick, 100);

                // Spin Completion
                setTimeout(() => {
                    currentRotation = finalRotation;
                    isSpinning = false;

                    // Transition to Result Screen
                    const formPanel = rootEl.querySelector('.stw-form-panel');
                    const resultPanel = rootEl.querySelector('.stw-result-panel');
                    const resultHeadline = rootEl.querySelector('.stw-result-headline');
                    const resultMsg = rootEl.querySelector('.stw-result-message');
                    const couponBox = rootEl.querySelector('.stw-coupon-box');
                    const couponCodeEl = rootEl.querySelector('.stw-coupon-code');
                    const expiryNote = rootEl.querySelector('.stw-expiry-note');

                    if (resultHeadline) resultHeadline.textContent = data.resultTitle;
                    if (resultMsg) resultMsg.textContent = data.resultText;

                    if (data.isWinner && data.couponCode) {
                        if (couponCodeEl) couponCodeEl.textContent = data.couponCode;
                        if (expiryNote && data.expiresAt) {
                            expiryNote.textContent = {{ 'Valid through: '|t('spin-to-win')|json_encode|raw }} + data.expiresAt;
                        }
                        if (couponBox) couponBox.style.display = 'block';

                        // Show Apply to Cart button if Craft Commerce discount is active
                        if (data.commerceAvailable) {
                            const applyBtns = rootEl.querySelectorAll('.stw-apply-cart-btn');
                            applyBtns.forEach(btn => {
                                btn.style.display = 'inline-flex';
                                btn.classList.remove('applied');
                                btn.disabled = false;
                            });
                        }
                    } else {
                        if (couponBox) couponBox.style.display = 'none';
                    }

                    if (formPanel) formPanel.style.display = 'none';
                    if (resultPanel) resultPanel.style.display = 'flex';

                    // Remember that user has spun and completed
                    markCampaignCompleted();
                }, durationMs + 100);
            })
            .catch(err => {
                isSpinning = false;
                if (submitBtn) {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = '<span>' + {{ campaign.buttonText|default('Spin to Win!')|json_encode|raw }} + '</span>';
                }
                if (errorAlert) {
                    errorAlert.textContent = {{ 'Network error. Please try again.'|t('spin-to-win')|json_encode|raw }};
                    errorAlert.style.display = 'block';
                }
            });
        }
    };

    // Initialize SVG Wheel
    renderSvgWheel();

    // Trigger Evaluation
    const trigger = rootEl.getAttribute('data-trigger');
    const delaySec = parseInt(rootEl.getAttribute('data-delay') || '0', 10);
    const scrollPct = parseInt(rootEl.getAttribute('data-scroll') || '0', 10);

    // Check if dismissed or already completed
    if (hasCompleted && !forceShow) {
        return;
    }

    let isDismissedRecently = false;
    try {
        if (!forceShow) {
            const navEntries = (window.performance && performance.getEntriesByType) ? performance.getEntriesByType('navigation') : [];
            const isReload = navEntries.length > 0 && navEntries[0].type === 'reload';
            const dismissedVal = sessionStorage.getItem('stw_dismissed_' + handle);
            const dismissedAt = parseInt(dismissedVal || '0', 10);

            // On page reload or after 30s, clear session dismissal so triggers fire cleanly
            if (isReload || dismissedVal === '1' || (dismissedAt && (Date.now() - dismissedAt > 30000))) {
                sessionStorage.removeItem('stw_dismissed_' + handle);
                isDismissedRecently = false;
            } else if (dismissedAt) {
                isDismissedRecently = true;
            }
        }
    } catch(e) {}

    // Allow manual open triggers on the page: [data-spin-trigger="handle"]
    document.querySelectorAll('[data-spin-trigger="' + handle + '"]').forEach(el => {
        el.addEventListener('click', function(e) {
            e.preventDefault();
            window['stwWidget_' + handle].open();
        });
    });

    // If not dismissed recently, evaluate automatic trigger based on admin settings
    if (!isDismissedRecently) {
        if (trigger === 'load') {
            setTimeout(() => window['stwWidget_' + handle].open(), 400);
        } else if (trigger === 'delay') {
            const delayMs = Math.max(0, delaySec) * 1000;
            setTimeout(() => window['stwWidget_' + handle].open(), delayMs);
        } else if (trigger === 'scroll') {
            let scrollFired = false;
            const targetPct = scrollPct > 0 ? scrollPct : 20;
            const onScroll = function() {
                if (scrollFired) return;
                const scrollTop = window.scrollY || document.documentElement.scrollTop;
                const docHeight = document.documentElement.scrollHeight - window.innerHeight;
                if (docHeight > 0) {
                    const pct = (scrollTop / docHeight) * 100;
                    if (pct >= targetPct) {
                        scrollFired = true;
                        window.removeEventListener('scroll', onScroll);
                        window['stwWidget_' + handle].open();
                    }
                }
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            // Evaluate in case page loads already scrolled
            onScroll();
        } else if (trigger === 'exit') {
            let exitFired = false;
            document.addEventListener('mouseleave', function(e) {
                if (exitFired) return;
                if (e.clientY <= 10) {
                    exitFired = true;
                    window['stwWidget_' + handle].open();
                }
            });
        }
    }
})();
</script>
{% endif %}
