                            <input type="email" name="email" class="stw-input-field stw-field-email" placeholder="{{ 'Enter email address'|t('spin-to-win') }}" required>

                            {% if campaign.requireConsent %}
                                <label style="display: flex; align-items: flex-start; gap: 6px; font-size: 11px; color: #64748b; cursor: pointer;">
