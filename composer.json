{
  "name": "abdulkadiragoliya/spin-to-win",
  "description": "Gamified Spin to Win prize wheel and promotional coupon system for Craft CMS and Craft Commerce.",
  "type": "craft-plugin",
  "keywords": [
    "craft",
    "cms",
    "craftcms",
    "craft-plugin",
    "commerce",
    "craft-commerce",
    "spin-to-win",
    "wheel",
    "coupons",
    "promotions",
    "marketing",
    "gamification"
  ],
  "homepage": "https://github.com/Abdulkadiragoliya/spin-to-win",
  "support": {
    "docs": "https://github.com/Abdulkadiragoliya/spin-to-win#readme",
    "issues": "https://github.com/Abdulkadiragoliya/spin-to-win/issues"
  },
  "license": "proprietary",
  "authors": [
    {
      "name": "Abdulkadir Agoliya",
      "homepage": "https://github.com/Abdulkadiragoliya"
    }
  ],
  "require": {
    "php": ">=8.0.2",
    "craftcms/cms": "^4.0.0 || ^5.0.0"
  },
  "suggest": {
    "craftcms/commerce": "Required for automated single-use coupon generation and cart discount synchronization (^4.0.0 || ^5.0.0)."
  },
  "require-dev": {
    "craftcms/generator": "^1.3.0 || ^2.0.0",
    "yiisoft/yii2-shell": "^2.0.3"
  },
  "autoload": {
    "psr-4": {
      "abdulkadiragoliya\\spintowin\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "abdulkadiragoliya\\spintowintests\\": "tests/"
    }
  },
  "extra": {
    "name": "Spin to Win",
    "handle": "spin-to-win",
    "developer": "Abdulkadir Agoliya",
    "developerUrl": "https://github.com/Abdulkadiragoliya",
    "documentationUrl": "https://github.com/Abdulkadiragoliya/spin-to-win#readme",
    "changelogUrl": "https://raw.githubusercontent.com/Abdulkadiragoliya/spin-to-win/main/CHANGELOG.md",
    "class": "abdulkadiragoliya\\spintowin\\SpinToWin",
    "editions": [
      {
        "name": "Lite",
        "handle": "lite",
        "price": 69,
        "renewalPrice": 29,
        "features": [
          "Interactive Live SVG Wheel Builder",
          "Custom Slice Labels, Colors & Weights",
          "Center Hub Logo Upload or Text",
          "Display Modes (Modal Popup & Slide Drawers)",
          "Basic Triggers (Page Load, Time Delay, Manual)",
          "Craft Commerce Discount Generation",
          "Daily Spin Limit & Cooldown (24h / Lifetime)",
          "Standard Dashboard & Spin History"
        ]
      },
      {
        "name": "Pro",
        "handle": "pro",
        "price": 99,
        "renewalPrice": 39,
        "features": [
          "All Lite Features",
          "Multi-Site Assignment & Regional Targeting",
          "Per-Site Settings Isolation",
          "Campaign Start & End Scheduling (Date/Time)",
          "Advanced Triggers (Scroll %, Exit-Intent, Inactivity)",
          "Automated Winner Notification Emails",
          "Double Opt-In Email Verification Tokens",
          "Advanced Coupon Expiry & Minimum Order Totals",
          "Comprehensive Analytics & Funnel Reports",
          "Filterable Reports by Campaign & Site",
          "Safe CSV Data Export (Spins & Coupons)"
        ]
      }
    ]
  }
}
